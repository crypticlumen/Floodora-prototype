# Copy to .env and replace placeholders with the sensor vendor's REST API details.
# The dashboard never reads credentials directly; only the backend uses them.
FLOODORA_SENSOR_NAME=Drain sensor REST API
FLOODORA_SENSOR_URL=
FLOODORA_SENSOR_API_TOKEN=
FLOODORA_SENSOR_AUTH_HEADER=Authorization
FLOODORA_SENSOR_AUTH_SCHEME=Bearer
FLOODORA_SENSOR_API_TOKEN_PARAM=
FLOODORA_SENSOR_TIMEOUT_SECONDS=8

# Either use {pincode}/{device_id} in SENSOR_URL, or let the adapter send these query parameters.
FLOODORA_SENSOR_PIN_PARAM=pincode
FLOODORA_SENSOR_DEVICE_PARAM=device_id

# Map the actual PIN to your vendor's drain/sensor identifier. Capacity can be a
# site configuration when the sensor itself does not report it.
FLOODORA_SENSOR_DEVICE_MAP='{"600020":{"device_id":"REPLACE_WITH_DEVICE_ID","capacity_cm":120}}'

# Optional: map project field names to dotted JSON paths in your vendor response.
# Example: {"water_level_cm":"data.level.value","blockage_pct":"telemetry.clog"}
FLOODORA_SENSOR_FIELD_MAP='{}'
